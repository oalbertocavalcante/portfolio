---
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './Icon.astro';

interface Props extends Omit<HTMLAttributes<'a'>, 'class'> {
  href: string;
  variant?: 'primary' | 'outline';
  icon?: IconName;
  tiltIcon?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  icon,
  tiltIcon = false,
  class: className,
  ...attributes
} = Astro.props;
const isExternal = /^https?:\/\//.test(href);
---

<a
  href={href}
  class:list={['button', `button--${variant}`, { 'button--tilt': tiltIcon }, className]}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  {...attributes}
>
  <slot />
  {icon && <Icon name={icon} class="button__icon" />}
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 17px 35px;
    border-radius: var(--radius-pill);
    font-size: var(--fs-button);
    line-height: 1;
    text-decoration: none;
    transition:
      background-position var(--duration-base),
      background-color var(--duration-fast),
      color var(--duration-fast);
  }

  .button--primary {
    font-weight: var(--fw-bold);
    color: var(--color-on-accent);
    background-image: var(--gradient-button);
    background-size: 200%;
  }

  .button--primary:hover,
  .button--primary:focus-visible {
    color: var(--color-on-accent);
    background-position: -100%;
  }

  .button--outline {
    font-weight: var(--fw-medium);
    letter-spacing: 1px;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
  }

  .button--outline:hover,
  .button--outline:focus-visible {
    color: var(--color-on-accent);
    background-color: var(--color-accent);
  }

  .button :global(.button__icon) {
    transition: transform var(--duration-base);
  }

  .button--tilt :global(.button__icon) {
    transform: rotate(-45deg);
  }

  .button--tilt:hover :global(.button__icon) {
    transform: rotate(0);
  }
</style>
