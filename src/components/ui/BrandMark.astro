---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['brand-mark', className]}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <path d="M10 46 20.5 17.5 31 46M14.4 36.5h12.2"></path>
  <path d="M54 23.5a11.5 11.5 0 1 0 0 17"></path>
</svg>

<style>
  .brand-mark {
    width: 60px;
    height: 60px;
    border-radius: 16px;
    background-color: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border);
  }

  .brand-mark path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
