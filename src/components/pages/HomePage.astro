---
import Preloader from '@/components/layout/Preloader.astro';
import ScrollTopButton from '@/components/layout/ScrollTopButton.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import RoleTicker from '@/components/sections/RoleTicker.astro';
import { getContent } from '@/data';
import type { Locale } from '@/i18n/locales';
import { homePaths } from '@/i18n/pages';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getContent(locale);
---

<BaseLayout locale={locale} paths={homePaths}>
  <Preloader label={content.ui.loading} />
  <SiteHeader locale={locale} paths={homePaths} content={content} navigation={content.navigation} />
  <main id="main">
    <HeroSection locale={locale} content={content} />
    <RoleTicker roles={content.roles} />
  </main>
  <ScrollTopButton label={content.ui.backToTop} />
</BaseLayout>
