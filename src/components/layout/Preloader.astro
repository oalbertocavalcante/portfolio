---
interface Props {
  label: string;
}

const { label } = Astro.props;
const letters = [...label.toUpperCase()];
---

<div class="preloader" data-preloader aria-hidden="true">
  <svg
    class="preloader__curtain"
    viewBox="0 0 1000 1000"
    preserveAspectRatio="none"
    focusable="false"
  >
    <path data-preloader-path d="M0 1005S175 995 500 995s500 5 500 5V0H0Z"></path>
  </svg>
  <div class="preloader__text" data-preloader-text>
    {letters.map((letter) => (
      <span>{letter}</span>
    ))}
  </div>
</div>

<script>
  import '@/scripts/preloader';
</script>

<style>
  .preloader {
    display: none;
  }

  :global(html.has-js) .preloader {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100vh;
    overflow: hidden;
    pointer-events: none;
  }

  .preloader__curtain {
    position: absolute;
    top: 0;
    width: 100vw;
    height: 110vh;
    fill: var(--color-canvas);
  }

  .preloader__text {
    position: relative;
    z-index: 1;
    font-size: 1.25rem;
    font-weight: var(--fw-light);
    letter-spacing: 15px;
    color: var(--color-heading);
  }

  .preloader__text span {
    display: inline-block;
    animation: preloader-blink 1s infinite alternate;
  }

  .preloader__text span:nth-child(2) {
    animation-delay: 0.1s;
  }

  .preloader__text span:nth-child(3) {
    animation-delay: 0.2s;
  }

  .preloader__text span:nth-child(4) {
    animation-delay: 0.3s;
  }

  .preloader__text span:nth-child(5) {
    animation-delay: 0.4s;
  }

  .preloader__text span:nth-child(6) {
    animation-delay: 0.5s;
  }

  .preloader__text span:nth-child(7) {
    animation-delay: 0.6s;
  }

  .preloader__text span:nth-child(8) {
    animation-delay: 0.7s;
  }

  .preloader__text span:nth-child(9) {
    animation-delay: 0.8s;
  }

  .preloader__text span:nth-child(10) {
    animation-delay: 0.9s;
  }

  .preloader__text span:nth-child(n + 11) {
    animation-delay: 1s;
  }

  @keyframes preloader-blink {
    from {
      opacity: 1;
    }

    to {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.has-js) .preloader {
      display: none;
    }
  }
</style>
