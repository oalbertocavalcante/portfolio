---
interface Props {
  label: string;
}

const { label } = Astro.props;
const letters = [...label.toUpperCase()];
---

<div class="preloader" data-preloader aria-hidden="true">
  <svg
    class="preloader__curtain"
    viewBox="0 0 1000 1000"
    preserveAspectRatio="none"
    focusable="false"
  >
    <path d="M0 1005S175 995 500 995s500 5 500 5V0H0Z">
      <animate
        data-preloader-curve
        attributeName="d"
        dur="0.5s"
        begin="indefinite"
        fill="freeze"
        calcMode="spline"
        keyTimes="0;1"
        keySplines="0.55 0.085 0.68 0.53"
        from="M0 1005S175 995 500 995s500 5 500 5V0H0Z"
        to="M0 502S175 272 500 272s500 230 500 230V0H0Z"
      ></animate>
      <animate
        data-preloader-flat
        attributeName="d"
        dur="0.5s"
        begin="indefinite"
        fill="freeze"
        calcMode="spline"
        keyTimes="0;1"
        keySplines="0.25 0.46 0.45 0.94"
        from="M0 502S175 272 500 272s500 230 500 230V0H0Z"
        to="M0 2S175 1 500 1s500 1 500 1V0H0Z"
      ></animate>
    </path>
  </svg>
  <div class="preloader__text" data-preloader-text>
    {letters.map((letter) => (
      <span>{letter}</span>
    ))}
  </div>
</div>

<script>
  import '@/scripts/preloader';
</script>

<style>
  .preloader {
    display: none;
  }

  :global(html.has-js) .preloader {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100vh;
    overflow: hidden;
    pointer-events: none;
    transition: transform 0.6s cubic-bezier(0.45, 0, 0.55, 1);
  }

  :global(html.has-js) .preloader.is-done {
    transform: translateY(-100%);
  }

  .preloader__curtain {
    position: absolute;
    top: 0;
    width: 100vw;
    height: 110vh;
    fill: var(--color-canvas);
  }

  .preloader__text {
    position: relative;
    z-index: 1;
    font-size: 1.25rem;
    font-weight: var(--fw-light);
    letter-spacing: 15px;
    color: var(--color-heading);
    transition:
      transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      opacity 0.5s ease;
  }

  .preloader.is-leaving .preloader__text {
    opacity: 0;
    transform: translateY(-100px);
  }

  .preloader__text span {
    display: inline-block;
    animation: preloader-blink 1s infinite alternate;
  }

  .preloader__text span:nth-child(2) {
    animation-delay: 0.1s;
  }

  .preloader__text span:nth-child(3) {
    animation-delay: 0.2s;
  }

  .preloader__text span:nth-child(4) {
    animation-delay: 0.3s;
  }

  .preloader__text span:nth-child(5) {
    animation-delay: 0.4s;
  }

  .preloader__text span:nth-child(6) {
    animation-delay: 0.5s;
  }

  .preloader__text span:nth-child(7) {
    animation-delay: 0.6s;
  }

  .preloader__text span:nth-child(8) {
    animation-delay: 0.7s;
  }

  .preloader__text span:nth-child(9) {
    animation-delay: 0.8s;
  }

  .preloader__text span:nth-child(10) {
    animation-delay: 0.9s;
  }

  .preloader__text span:nth-child(n + 11) {
    animation-delay: 1s;
  }

  @keyframes preloader-blink {
    from {
      opacity: 1;
    }

    to {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.has-js) .preloader {
      display: none;
    }
  }
</style>
