---
import Icon from '@/components/ui/Icon.astro';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button type="button" class="scroll-top" data-scroll-top aria-label={label}>
  <svg class="scroll-top__progress" viewBox="-1 -1 102 102" aria-hidden="true" focusable="false">
    <path data-scroll-top-path d="M50 1a49 49 0 0 1 0 98a49 49 0 0 1 0-98"></path>
  </svg>
  <span class="scroll-top__icon">
    <Icon name="bi:arrow-up" />
  </span>
</button>

<script>
  import '@/scripts/scroll-top';
</script>

<style>
  .scroll-top {
    position: fixed;
    right: 30px;
    bottom: 25px;
    z-index: 900;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 0.1rem var(--color-accent-deep);
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.75rem);
    transition:
      opacity 0.2s linear,
      visibility 0.2s linear,
      transform 0.2s linear;
  }

  .scroll-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .scroll-top__progress {
    width: 100%;
    height: 100%;
  }

  .scroll-top__progress path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 4;
  }

  .scroll-top__icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: var(--color-accent);
  }

  @media (max-width: 767.98px) {
    .scroll-top {
      right: 15px;
      bottom: 15px;
    }
  }
</style>
