---
import PageSection from '@/components/layout/PageSection.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { media } from '@/data/media';
import type { SiteContent } from '@/data/types';
import TestimonialsCarousel from './TestimonialsCarousel.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { testimonials, anchors, ui } = content;
const headingId = 'testimonials-title';

const items = testimonials.items.map((item) => {
  if (!item.photo) return { ...item, image: undefined };
  const image = media.testimonials[item.photo];
  if (!image) throw new Error(`Foto não encontrada para o depoimento: ${item.photo}`);
  return { ...item, image };
});
---

{items.length > 0 && (
  <PageSection
    section="testimonials"
    anchor={anchors.testimonials}
    tone="band-alt"
    labelledBy={headingId}
    class="testimonials"
  >
    <div class="container-wide testimonials__grid">
      <div class="testimonials__intro">
        <SectionHeading
          id={headingId}
          title={testimonials.title}
          description={testimonials.description}
          align="start"
        />
      </div>
      <div class="testimonials__carousel" data-reveal="fade-left" data-reveal-delay="5">
        <TestimonialsCarousel
          items={items}
          slideLabel={ui.carouselSlide}
          bulletLabel={ui.carouselBullet}
        />
      </div>
    </div>
  </PageSection>
)}

<style>
  .testimonials {
    overflow-x: clip;
    padding: var(--space-section) 0;
  }

  .testimonials__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 30px;
  }

  .testimonials__intro,
  .testimonials__carousel {
    width: 48%;
    min-width: 0;
  }

  @media (min-width: 1200px) and (max-width: 1399.98px) {
    .testimonials__grid {
      padding-right: 0;
    }
  }

  @media (max-width: 1199.98px) {
    .testimonials__grid {
      gap: 50px;
    }

    .testimonials__intro,
    .testimonials__carousel {
      width: 100%;
    }
  }

  @media (max-width: 767.98px) {
    .testimonials__grid {
      gap: 0;
    }

    .testimonials__intro {
      margin-bottom: 40px;
    }
  }
</style>
