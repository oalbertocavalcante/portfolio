---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { TestimonialItem } from '@/data/types';

interface Props {
  items: (TestimonialItem & { image: ImageMetadata | undefined })[];
  slideLabel: string;
  bulletLabel: string;
}

const { items, slideLabel, bulletLabel } = Astro.props;
const markPath =
  'M.105 2.19C.03.989 1.025-.006 2.227.069l17.27 1.082c1.718.108 2.506 2.193 1.288 3.41L4.598 20.749c-1.218 1.217-3.303.43-3.41-1.29Z';
---

<div
  class="swiper testimonials-carousel"
  data-testimonials
  data-label-slide={slideLabel}
  data-label-bullet={bulletLabel}
>
  <ul class="swiper-wrapper list-reset">
    {items.map((item) => (
      <li class="swiper-slide testimonials-carousel__slide">
        <figure class="testimonial">
          {item.image && (
            <div class="testimonial__photo">
              <Image src={item.image} alt="" widths={[120, 240]} sizes="120px" />
            </div>
          )}
          <div class="testimonial__mark" aria-hidden="true">
            <svg viewBox="0 0 22 22" focusable="false">
              <path d={markPath} />
            </svg>
            <svg viewBox="0 0 22 22" focusable="false">
              <path d={markPath} />
            </svg>
          </div>
          <blockquote class="testimonial__quote">
            <p>{item.quote}</p>
          </blockquote>
          <figcaption>
            <p class="testimonial__name">{item.name}</p>
            <p class="testimonial__role">{item.role}</p>
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>
  <div class="testimonials-carousel__pagination" data-testimonials-pagination></div>
</div>

<script>
  import '@/scripts/testimonials-slider';
</script>

<style>
  .testimonials-carousel__slide {
    width: 300px;
    height: auto;
  }

  .testimonial {
    height: 100%;
    margin: 0;
    padding: 25px;
    border-radius: 15px;
    background-color: var(--color-surface);
  }

  .testimonial__photo {
    width: 40%;
    max-width: 120px;
    margin-bottom: 20px;
  }

  .testimonial__photo :global(img) {
    width: 100%;
    border-radius: 5px 5px 5px 125px;
  }

  .testimonial__mark {
    display: flex;
    margin-bottom: 25px;
  }

  .testimonial__mark svg {
    width: 22px;
    height: 22px;
    margin-right: 5px;
    fill: var(--color-accent);
  }

  :global(.swiper-slide-active) .testimonial__mark svg:first-child,
  :global(.swiper-slide-next) .testimonial__mark svg:first-child {
    animation: testimonial-turn 1s 0.5s both;
  }

  :global(.swiper-slide-active) .testimonial__mark svg:last-child,
  :global(.swiper-slide-next) .testimonial__mark svg:last-child {
    animation: testimonial-turn-shift 1s 0.5s both;
  }

  .testimonial__quote {
    margin: 0 0 50px;
  }

  .testimonial__quote p {
    margin: 0;
    font-size: var(--fs-body);
  }

  .testimonial__name {
    margin-bottom: 5px;
    font-size: 1.125rem;
    font-weight: var(--fw-bold);
    color: var(--color-heading);
  }

  .testimonial__role {
    margin: 0;
    font-size: 0.875rem;
  }

  .testimonials-carousel__pagination {
    display: flex;
    justify-content: center;
    gap: 5px;
    margin-top: 25px;
  }

  .testimonials-carousel__pagination :global(.swiper-pagination-bullet) {
    display: block;
    width: 14px;
    height: 14px;
    padding: 3px;
    border-radius: 50%;
    background-color: transparent;
    background-clip: content-box;
    background-image: linear-gradient(
      color-mix(in srgb, var(--color-text-muted) 40%, transparent),
      color-mix(in srgb, var(--color-text-muted) 40%, transparent)
    );
    cursor: pointer;
    transition: background-image var(--duration-fast);
  }

  .testimonials-carousel__pagination :global(.swiper-pagination-bullet-active) {
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
  }

  :global(html:not(.has-js)) .testimonials-carousel :global(.swiper-wrapper) {
    gap: 30px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  :global(html:not(.has-js)) .testimonials-carousel__slide {
    flex-shrink: 0;
    scroll-snap-align: start;
  }

  @keyframes testimonial-turn {
    from {
      transform: rotate(0);
    }

    to {
      transform: rotate(-45deg);
    }
  }

  @keyframes testimonial-turn-shift {
    from {
      transform: translateX(0) rotate(0);
    }

    to {
      transform: translateX(-22px) rotate(135deg);
    }
  }

  @media (max-width: 991.98px) {
    .testimonials-carousel__slide {
      width: auto;
    }
  }

  @media (max-width: 767.98px) {
    .testimonial__quote {
      margin-bottom: 30px;
    }
  }
</style>
