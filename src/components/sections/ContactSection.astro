---
import ContactDetails from '@/components/contact/ContactDetails.astro';
import ContactForm from '@/components/contact/ContactForm.astro';
import PageSection from '@/components/layout/PageSection.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { SiteContent } from '@/data/types';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
  content: SiteContent;
}

const { locale, content } = Astro.props;
const { contact, anchors } = content;
const headingId = 'contact-title';
---

<PageSection
  section="contact"
  anchor={anchors.contact}
  tone="band-alt"
  labelledBy={headingId}
  class="contact"
>
  <div class="container-wide contact__grid">
    <div class="contact__card" data-reveal data-reveal-delay="3">
      <SectionHeading
        id={headingId}
        title={contact.title}
        description={contact.description}
        align="start"
        class="contact__heading"
      />
      <ContactForm locale={locale} contact={contact} />
    </div>
    <div class="contact__details">
      <ContactDetails info={contact.info} />
    </div>
  </div>
</PageSection>

<style>
  .contact {
    padding: var(--space-section) 0;
  }

  .contact__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .contact__card {
    width: 48%;
    padding: 50px;
    border-radius: 12px;
    background-color: var(--color-surface);
  }

  .contact :global(.contact__heading) {
    margin-bottom: 50px;
  }

  .contact__details {
    width: 40%;
  }

  @media (max-width: 1399.98px) {
    .contact__card {
      width: 56%;
    }
  }

  @media (max-width: 1199.98px) {
    .contact__grid {
      gap: 25px;
    }

    .contact__card {
      padding: 30px 20px;
    }
  }

  @media (max-width: 991.98px) {
    .contact :global(.contact__heading) {
      margin-bottom: 40px;
    }
  }

  @media (max-width: 767.98px) {
    .contact__grid {
      flex-direction: column;
      align-items: stretch;
      gap: 50px;
    }

    .contact__card,
    .contact__details {
      width: 100%;
    }

    .contact__card {
      padding: 30px 15px;
    }

    .contact__details {
      order: -1;
    }
  }
</style>
